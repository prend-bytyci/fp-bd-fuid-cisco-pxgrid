# Cisco ISE pxGrid Settings
PXGRID_CLIENT_ACCOUNT_NAME=pxgrid-client
PXGRID_CLIENT_ACCOUNT_PASSWORD=your-pxgrid-password

PXGRID_HOST_ADDRESS=ise.example.com

# Forcepoint FUID Settings
FUID_API_USERNAME=fuid-api-user
FUID_API_PASSWORD=your-fuid-password
FUID_IP_ADDRESS=fuid.example.com

# Active Directory / LDAP Settings
AD_LDAP_HOST=dc.example.com
AD_LDAP_USER_DN=CN=ServiceUser,CN=Users,DC=example,DC=com
AD_LDAP_PASSWORD=your-ldap-password
AD_DOMAIN_NAME=example.com

# Optional Settings (defaults shown)
SESSION_LISTENER_INTERVAL_TIME=3
SAVE_LOGS=false
DISPLAY_INFO=true
IGNORE_UNKNOWN_SESSIONS=true
ISE_PORT=8910
FUID_PORT=5000
AD_PORT=636
